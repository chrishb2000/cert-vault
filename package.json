{
  "name": "cert-vault",
  "version": "1.0.0",
  "description": "Gestor de Certificados Digitales - Exportar, Importar e Instalar certificados en Windows",
  "main": "src/main/main.js",
  "scripts": {
    "start": "concurrently \"vite --config vite.config.js\" \"wait-on http://localhost:5173 && electron .\"",
    "build:renderer": "vite build --config vite.config.js",
    "build:win": "npm run build:renderer && electron-builder --win --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "Christian Herencia",
  "license": "MIT",
  "dependencies": {
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.christianfreelance.cert-vault",
    "productName": "Cert Vault",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "src/main/**/*",
      "src/renderer/dist/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": null
    }
  }
}
